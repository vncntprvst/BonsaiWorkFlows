<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:vid="clr-namespace:Bonsai.Video;assembly=Bonsai.Video" xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision" xmlns:p1="clr-namespace:Neurophotometrics;assembly=Neurophotometrics" xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System" xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vid:VideoCaptureDevice">
          <vid:Index>1</vid:Index>
          <vid:Format>
            <vid:FrameSize>
              <vid:Width>1280</vid:Width>
              <vid:Height>720</vid:Height>
            </vid:FrameSize>
            <vid:AverageFrameRate>30</vid:AverageFrameRate>
            <vid:MaximumFrameRate>30</vid:MaximumFrameRate>
            <vid:BitCount>24</vid:BitCount>
          </vid:Format>
          <vid:CaptureProperties />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:VideoWriter">
          <cv:FileName>C:\Users\owner\Documents\Yonatan\Videos\Video.avi</cv:FileName>
          <cv:Suffix>Timestamp</cv:Suffix>
          <cv:Buffered>true</cv:Buffered>
          <cv:Overwrite>true</cv:Overwrite>
          <cv:FourCC>FMP4</cv:FourCC>
          <cv:FrameRate>30</cv:FrameRate>
          <cv:FrameSize>
            <cv:Width>1280</cv:Width>
            <cv:Height>720</cv:Height>
          </cv:FrameSize>
          <cv:ResizeInterpolation>NearestNeighbor</cv:ResizeInterpolation>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:FP3002">
          <p1:PortName>COM4</p1:PortName>
          <p1:Regions>
            <p1:RotatedRect>
              <p1:Center>
                <p1:X>115.5</p1:X>
                <p1:Y>816.5</p1:Y>
              </p1:Center>
              <p1:Size>
                <p1:Width>87</p1:Width>
                <p1:Height>107</p1:Height>
              </p1:Size>
              <p1:Angle>0</p1:Angle>
            </p1:RotatedRect>
            <p1:RotatedRect>
              <p1:Center>
                <p1:X>884.5</p1:X>
                <p1:Y>671.5</p1:Y>
              </p1:Center>
              <p1:Size>
                <p1:Width>87</p1:Width>
                <p1:Height>115</p1:Height>
              </p1:Size>
              <p1:Angle>0</p1:Angle>
            </p1:RotatedRect>
          </p1:Regions>
          <p1:AutoCrop>true</p1:AutoCrop>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryData">
          <p1:Filter>L560</p1:Filter>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryWriter">
          <p1:FileName>C:\Users\owner\Documents\Yonatan\DataFiles\L560\FIle1.csv</p1:FileName>
          <p1:Suffix>None</p1:Suffix>
          <p1:Buffered>true</p1:Buffered>
          <p1:Overwrite>true</p1:Overwrite>
          <p1:IncludeRegions>false</p1:IncludeRegions>
          <p1:IncludeChart>true</p1:IncludeChart>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryData">
          <p1:Filter>L410</p1:Filter>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryWriter">
          <p1:FileName>C:\Users\owner\Documents\Yonatan\DataFiles\L415\File2</p1:FileName>
          <p1:Suffix>None</p1:Suffix>
          <p1:Buffered>true</p1:Buffered>
          <p1:Overwrite>true</p1:Overwrite>
          <p1:IncludeRegions>false</p1:IncludeRegions>
          <p1:IncludeChart>true</p1:IncludeChart>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryData">
          <p1:Filter>L470</p1:Filter>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryWriter">
          <p1:FileName>C:\Users\owner\Documents\Yonatan\DataFiles\L470\File3.csv</p1:FileName>
          <p1:Suffix>None</p1:Suffix>
          <p1:Buffered>true</p1:Buffered>
          <p1:Overwrite>true</p1:Overwrite>
          <p1:IncludeRegions>false</p1:IncludeRegions>
          <p1:IncludeChart>true</p1:IncludeChart>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryData">
          <p1:Filter xsi:nil="true" />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PhotometryWriter">
          <p1:FileName>C:\Users\owner\Documents\Yonatan\DataFiles\PhotometryData\File4.csv</p1:FileName>
          <p1:Suffix>None</p1:Suffix>
          <p1:Buffered>true</p1:Buffered>
          <p1:Overwrite>true</p1:Overwrite>
          <p1:IncludeRegions>false</p1:IncludeRegions>
          <p1:IncludeChart>true</p1:IncludeChart>
        </Combinator>
      </Expression>
      <Expression xsi:type="p1:DigitalInput">
        <p1:Type>Input0</p1:Type>
        <p1:IncludeTimestamp>true</p1:IncludeTimestamp>
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>C:\Users\owner\Documents\Yonatan\DataFiles\BpodData\My_Data_Reward.csv</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>true</io:Overwrite>
        <io:Suffix>None</io:Suffix>
        <io:IncludeHeader>false</io:IncludeHeader>
      </Expression>
      <Expression xsi:type="p1:DigitalInput">
        <p1:Type>Input1</p1:Type>
        <p1:IncludeTimestamp>true</p1:IncludeTimestamp>
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>C:\Users\owner\Documents\Yonatan\DataFiles\BpodData\My_Data_Pokes.csv</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>true</io:Overwrite>
        <io:Suffix>None</io:Suffix>
        <io:IncludeHeader>false</io:IncludeHeader>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="2" To="5" Label="Source1" />
      <Edge From="2" To="7" Label="Source1" />
      <Edge From="2" To="9" Label="Source1" />
      <Edge From="2" To="11" Label="Source1" />
      <Edge From="2" To="13" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="11" To="12" Label="Source2" />
      <Edge From="13" To="14" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>