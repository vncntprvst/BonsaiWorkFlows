<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:vid="clr-namespace:Bonsai.Video;assembly=Bonsai.Video" xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System" xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vid:VideoCaptureDevice">
          <vid:Index>1</vid:Index>
          <vid:CaptureProperties />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:RoiActivity">
          <cv:Regions>
            <cv:ArrayOfPoint>
              <cv:Point>
                <cv:X>7</cv:X>
                <cv:Y>12</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>344</cv:X>
                <cv:Y>12</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>344</cv:X>
                <cv:Y>92</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>7</cv:X>
                <cv:Y>92</cv:Y>
              </cv:Point>
            </cv:ArrayOfPoint>
            <cv:ArrayOfPoint>
              <cv:Point>
                <cv:X>6</cv:X>
                <cv:Y>398</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>343</cv:X>
                <cv:Y>398</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>343</cv:X>
                <cv:Y>478</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>6</cv:X>
                <cv:Y>478</cv:Y>
              </cv:Point>
            </cv:ArrayOfPoint>
            <cv:ArrayOfPoint>
              <cv:Point>
                <cv:X>296</cv:X>
                <cv:Y>392</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>633</cv:X>
                <cv:Y>392</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>633</cv:X>
                <cv:Y>472</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>296</cv:X>
                <cv:Y>472</cv:Y>
              </cv:Point>
            </cv:ArrayOfPoint>
            <cv:ArrayOfPoint>
              <cv:Point>
                <cv:X>300</cv:X>
                <cv:Y>8</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>637</cv:X>
                <cv:Y>8</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>637</cv:X>
                <cv:Y>88</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>300</cv:X>
                <cv:Y>88</cv:Y>
              </cv:Point>
            </cv:ArrayOfPoint>
          </cv:Regions>
          <cv:Operation>Sum</cv:Operation>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:Defer">
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index>0</cv:Index>
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index xsi:nil="true" />
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index>0</cv:Index>
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index xsi:nil="true" />
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index>0</cv:Index>
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index xsi:nil="true" />
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="0" To="3" Label="Source1" />
            <Edge From="0" To="4" Label="Source1" />
            <Edge From="0" To="5" Label="Source1" />
            <Edge From="0" To="6" Label="Source1" />
            <Edge From="1" To="7" Label="Source1" />
            <Edge From="2" To="7" Label="Source2" />
            <Edge From="3" To="7" Label="Source3" />
            <Edge From="4" To="7" Label="Source4" />
            <Edge From="5" To="7" Label="Source5" />
            <Edge From="6" To="7" Label="Source6" />
            <Edge From="7" To="8" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:Defer">
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index>0</cv:Index>
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:RoiActivityDetected">
                <cv:Index xsi:nil="true" />
                <cv:Threshold>0</cv:Threshold>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="2" To="3" Label="Source2" />
            <Edge From="3" To="4" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>E:\Data\Video\tests\testCSV.csv</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>false</io:Overwrite>
        <io:Suffix>FileCount</io:Suffix>
        <io:IncludeHeader>false</io:IncludeHeader>
        <io:Selector>Item1,Item2</io:Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="4" Label="Source1" />
      <Edge From="3" To="4" Label="Source2" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>