<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:p1="clr-namespace:Bonsai.Ephys;assembly=Bonsai.Ephys" xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp" xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:IntanEvalBoard">
          <p1:HighPassFilter>true</p1:HighPassFilter>
          <p1:HighPassFilterCutoff>1</p1:HighPassFilterCutoff>
          <p1:NotchFilter>false</p1:NotchFilter>
          <p1:NotchFrequency>60</p1:NotchFrequency>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>DataFrame</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:SelectChannels" />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>