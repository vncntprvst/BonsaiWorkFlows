                        <Expression xsi:type="ipy:PythonTransform">
                          <ipy:Script>import clr
from System import Random

def getOutputType():
    return clr.GetClrType(bool)

generator = Random()

def process(input):
  a=generator.NextDouble()
  if (a&lt;=input.Item2 and input.Item1):
  	return True
  else:
    return False</ipy:Script>
                        </Expression>
