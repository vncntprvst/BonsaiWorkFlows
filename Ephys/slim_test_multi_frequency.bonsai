                    <ipy:Script>import math

@returns(float)
def process(input):
  valindex = 6 ## Probability
  i = input.Item2
  CHindex = int(math.fmod(i,2))
  data = input.Item1[i][valindex+CHindex]
  return data</ipy:Script>
