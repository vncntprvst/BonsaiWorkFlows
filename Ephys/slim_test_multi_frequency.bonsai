                  <Expression xsi:type="ipy:PythonTransform">
                    <ipy:Script>import math

@returns(bool)
def process(input):
  valindex = 8 ## Stop condition
  i = input.Item2
  CHindex = int(math.fmod(i,2))
  data = input.Item1[i][valindex+CHindex]
  if data == 1:
    return True
  else:
    return False</ipy:Script>
                  </Expression>
