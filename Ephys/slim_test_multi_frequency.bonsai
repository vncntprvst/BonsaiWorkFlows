                  <Expression xsi:type="ipy:PythonTransform">
                    <ipy:Script>from System import TimeSpan
import math

@returns(TimeSpan)
def process(input):
  valindex = 2 ## Delay
  i = input.Item2
  CHindex = int(math.fmod(i,2))
  data = input.Item1[i][valindex+CHindex]
  return TimeSpan.FromMilliseconds(data)</ipy:Script>
