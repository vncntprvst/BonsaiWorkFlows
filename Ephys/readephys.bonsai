<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp" xmlns:p1="clr-namespace:Bonsai.Ephys;assembly=Bonsai.Ephys" xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:MatrixReader">
          <dsp:Offset>0</dsp:Offset>
          <dsp:SampleRate>0</dsp:SampleRate>
          <dsp:ChannelCount>32</dsp:ChannelCount>
          <dsp:BufferLength>60</dsp:BufferLength>
          <dsp:Depth>U16</dsp:Depth>
          <dsp:Layout>ColumnMajor</dsp:Layout>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:AdcScale">
          <p1:AdcType>Electrode</p1:AdcType>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:ReferenceChannels" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:FrequencyFilter">
          <dsp:SampleRate>44100</dsp:SampleRate>
          <dsp:Cutoff1>300</dsp:Cutoff1>
          <dsp:Cutoff2>6000</dsp:Cutoff2>
          <dsp:KernelLength>60</dsp:KernelLength>
          <dsp:FilterType>BandPass</dsp:FilterType>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:DetectSpikes">
          <dsp:Delay>10</dsp:Delay>
          <dsp:Length>30</dsp:Length>
          <dsp:Threshold>
            <dsp:double>-43.84573207543847</dsp:double>
            <dsp:double>-31.315746352885185</dsp:double>
            <dsp:double>-29.399102383651051</dsp:double>
            <dsp:double>-24.206334415715133</dsp:double>
            <dsp:double>-25.486415988019825</dsp:double>
            <dsp:double>-26.382091490049525</dsp:double>
            <dsp:double>-24.242059351337375</dsp:double>
            <dsp:double>-35.208453351080983</dsp:double>
            <dsp:double>-25.1328443778346</dsp:double>
            <dsp:double>-24.438603697000215</dsp:double>
            <dsp:double>-29.049649596751021</dsp:double>
            <dsp:double>-27.253329730890382</dsp:double>
            <dsp:double>-28.450663242435681</dsp:double>
            <dsp:double>-26.996855399976564</dsp:double>
            <dsp:double>-25.96418572697532</dsp:double>
            <dsp:double>-24.366415597075807</dsp:double>
            <dsp:double>-26.291910220965757</dsp:double>
            <dsp:double>-25.22130244451602</dsp:double>
            <dsp:double>-30.152688076998214</dsp:double>
            <dsp:double>-25.468707134496551</dsp:double>
            <dsp:double>-25.832000608878118</dsp:double>
            <dsp:double>-24.714356226563446</dsp:double>
            <dsp:double>-28.892277082052768</dsp:double>
            <dsp:double>-23.504655040055788</dsp:double>
            <dsp:double>-22.74539740146691</dsp:double>
            <dsp:double>-26.622609203784695</dsp:double>
            <dsp:double>-28.113216122447284</dsp:double>
            <dsp:double>-29.674182415718942</dsp:double>
            <dsp:double>-28.202242905077242</dsp:double>
            <dsp:double>-29.47627082874801</dsp:double>
            <dsp:double>-23.816577285171892</dsp:double>
            <dsp:double>-35.063351633347104</dsp:double>
          </dsp:Threshold>
          <dsp:WaveformRefinement>AlignPeaks</dsp:WaveformRefinement>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>