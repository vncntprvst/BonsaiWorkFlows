                    <cv:Point>
                      <cv:X>342</cv:X>
                      <cv:Y>69</cv:Y>
                    </cv:Point>
                    <cv:Point>
                      <cv:X>367</cv:X>
                      <cv:Y>94</cv:Y>
                    </cv:Point>
