                      <cv:X>536</cv:X>
                      <cv:Y>166</cv:Y>
                    </cv:Point>
                    <cv:Point>
                      <cv:X>555</cv:X>
                      <cv:Y>215</cv:Y>
                    </cv:Point>
                    <cv:Point>
                      <cv:X>539</cv:X>
